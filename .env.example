# Identidade da instalação e caminhos persistentes
TIM_SISTEMA=vendas-multicanal
TIM_APP_DIR=./
TIM_DATA_DIR=./data
TIM_DB_PATH=./data/vendas-multicanal.db

# Painel: troque os dois valores antes de usar fora da máquina local
TIM_PANEL_HOST=127.0.0.1
TIM_PANEL_PORT=8080
TIM_PANEL_PASSWORD=troque-por-uma-senha-forte
TIM_PANEL_SECRET=troque-por-um-segredo-aleatorio-longo
TIM_PUBLIC_URL=http://127.0.0.1:8080

# Chrome dedicado. Nunca exponha esta porta na internet.
TIM_CDP_ENDPOINT=http://127.0.0.1:9222

# Contexto comercial e de agenda
TIM_LUGAR_BASE=Cidade Base

# Identidade opcional. Também pode ser preenchida em data/sobre-mim/dono.json.
# TIM_DONO={"nome":"Nome de Exemplo","genero":"f"}
# TIM_DONO_GENERO=x
# TIM_INTERLOCUTOR_GENERO=x

# Google Agenda, opcional
# GOOGLE_AGENDA_CLIENT_ID=
# GOOGLE_AGENDA_CLIENT_SECRET=

# Telegram, opcional
# TIM_TG_API_ID=
# TIM_TG_API_HASH=

# Binários opcionais quando não estiverem no PATH
# TIM_CODEX_BINARY=codex
# TIM_FFMPEG=ffmpeg
# TIM_WHISPER_PY=/opt/vendas-multicanal/whisper-venv/bin/python

# Testes/intervalos avançados têm outras variáveis TIM_*; mantenha os padrões até
# entender a capacidade correspondente.
